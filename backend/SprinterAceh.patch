+// Called before any uploads or submission writes for SPRINTER ACEH.
+function validateAcehDocuments(files) {
+  const required = [
+    ['ktp', 'ktp', 'KTP'], ['familyCard', 'kartuKeluarga', 'Kartu Keluarga'],
+    ['powerOfAttorney', 'suratKuasa', 'Surat Kuasa'], ['diploma', 'diploma', 'Ijazah'], ['sim', 'diploma', 'SIM']
+  ];
+  required.forEach(function (entry) {
+    const file = files[entry[0]];
+    if (!file || !file.base64) throw new Error(entry[2] + ' wajib diunggah');
+    if (ALLOWED_MIME_TYPES[entry[1]].indexOf(file.mimeType) === -1) throw new Error('Format ' + entry[2] + ' tidak valid');
+    const bytes = Utilities.base64Decode(file.base64);
+    if (!bytes.length || bytes.length > MAX_FILE_SIZE || Number(file.size) !== bytes.length) {
+      throw new Error('Ukuran ' + entry[2] + ' tidak valid (maksimal 5MB dan tidak boleh kosong)');
+    }
+  });
+}
+
+// Submission holds the script lock, preventing concurrent duplicate SIM folders.
+function getSimFolderId() {
+  const properties = PropertiesService.getScriptProperties();
+  const configured = properties.getProperty('SIM_FOLDER_ID');
+  if (configured) return configured;
+  const root = DriveApp.getFolderById(UPLOADS_FOLDER_ID);
+  const folders = root.getFoldersByName('SIM');
+  const folder = folders.hasNext() ? folders.next() : root.createFolder('SIM');
+  properties.setProperty('SIM_FOLDER_ID', folder.getId());
+  return folder.getId();
+}
